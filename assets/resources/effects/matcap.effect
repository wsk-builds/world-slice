// 零灯光球面高光 MatCap / 法线照明 Effect（GDD §3.1、§9.2）
// 兼容纯程序半球高光（无需贴图）与外部 MatCap 贴图（USE_MATCAP_TEX），场景零灯光、零阴影开销。

CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: matcap-vs:vert
      frag: matcap-fs:frag
      properties: &props
        mainColor:      { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
        matcapParams:   { value: [0.48, 28.0, 0.28, 0.36] } # x: specStrength, y: shininess, z: rimStrength, w: ambientFloor
        obliqueParams:  { value: [0.2493, -0.29, 0.0, 0.0] } # x: obliqueShearY, y: zGroundRef
        matcapTex:      { value: white, editor: { parent: USE_MATCAP_TEX } }
}%

CCProgram matcap-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  uniform MatcapConstants {
    vec4 mainColor;
    vec4 matcapParams;
    vec4 obliqueParams;
  };

  out vec3 v_viewNormal;
  out vec3 v_worldNormal;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    // 正轴测斜俯视投影（Orthographic Oblique Cabinet Projection）：
    // 1. 平行正交相机 + 仅按前后纵深 worldPos.z 产生斜向俯视高度差；
    // 2. 竖直柱杆 (dx=0) 在屏幕任意位置 100% 笔直不歪斜；
    // 3. 平躺圆环清晰露出立体圆孔，且缸底前缘紧贴内屏底线零浮空！
    vec4 viewPos = cc_matView * worldPos;
    viewPos.y -= (worldPos.z + obliqueParams.y) * obliqueParams.x;

    vec3 worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
    v_worldNormal = worldNormal;

    vec3 viewN = (cc_matView * vec4(worldNormal, 0.0)).xyz;
    viewN.z += worldNormal.y * obliqueParams.x;
    v_viewNormal = normalize(viewN);

    return cc_matProj * viewPos;
  }
}%

CCProgram matcap-fs %{
  precision highp float;
  #include <legacy/output-standard>

  in vec3 v_viewNormal;
  in vec3 v_worldNormal;

  #if USE_MATCAP_TEX
    uniform sampler2D matcapTex;
  #endif

  uniform MatcapConstants {
    vec4 mainColor;
    vec4 matcapParams;
    vec4 obliqueParams;
  };

  vec4 frag () {
    vec3 vn = normalize(v_viewNormal);
    vec3 wn = normalize(v_worldNormal);

    #if USE_MATCAP_TEX
      vec2 muv = vn.xy * 0.49 + 0.5;
      vec4 mc = texture(matcapTex, vec2(muv.x, 1.0 - muv.y));
      vec3 col = mainColor.rgb * SRGBToLinear(mc.rgb) * 1.35;
      return CCFragOutput(vec4(col, mainColor.a));
    #else
      // 视角空间固定斜上方主光 + 水底青蓝反光 + 球面高光 + 菲涅尔柔光边，翻转时高光真实流转
      vec3 lightDir = normalize(vec3(-0.36, 0.66, 0.66));
      vec3 viewDir = vec3(0.0, 0.0, 1.0);
      vec3 halfDir = normalize(lightDir + viewDir);

      float ndl = dot(vn, lightDir) * 0.5 + 0.5;
      float shade = mix(matcapParams.w, 1.12, smoothstep(0.08, 0.95, ndl));

      // 内孔与下腹部深水环境微反光，增强圆环孔洞立体感
      float bounce = max(0.0, -wn.y) * 0.12;
      vec3 bounceTint = vec3(0.08, 0.22, 0.28) * bounce;

      float spec = pow(max(0.0, dot(vn, halfDir)), matcapParams.y) * matcapParams.x;
      float rim = pow(1.0 - max(0.0, vn.z), 2.6) * matcapParams.z;

      vec3 rgb = mainColor.rgb * shade + bounceTint + vec3(spec) + mainColor.rgb * rim;
      return CCFragOutput(vec4(rgb, mainColor.a));
    #endif
  }
}%
